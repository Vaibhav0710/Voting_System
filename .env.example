# Copy to .env (git-ignored) and fill in. docker compose reads .env automatically.
# Every value marked REQUIRED makes `docker compose up` refuse to start when it is missing.

# ── Database (REQUIRED) ────────────────────────────────────────────────
VOTING_DB_USER=voting
VOTING_DB_PASSWORD=change-me

# ── JWT (REQUIRED) — Base64, at least 256 bits, shared by all services ─
# Generate: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION=86400000

# ── Bootstrap administrator (optional; created once when all three are set)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ── Behaviour ──────────────────────────────────────────────────────────
VOTING_CHAIN_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Observability ──────────────────────────────────────────────────────
# Plain run:                 SPRING_PROFILES_ACTIVE=json-logs   TRACING_SAMPLING=0.0
# With --profile observability: SPRING_PROFILES_ACTIVE=json-logs,logstash   TRACING_SAMPLING=1.0
SPRING_PROFILES_ACTIVE=json-logs
TRACING_SAMPLING=0.0
GRAFANA_ADMIN_PASSWORD=change-me
